* {
    primary: #888888;
    primary-fixed: #888888;
    primary-fixed-dim: #888888;
    on-primary: #ffffff;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #ffffff;
    primary-container: #595959;
    on-primary-container: #ffffff;
    secondary: #E5A700;
    secondary-fixed: #E5A700;
    secondary-fixed-dim: #E5A700;
    on-secondary: #ffffff;
    on-secondary-fixed: #ffffff;
    on-secondary-fixed-variant: #ffffff;
    secondary-container: #3b3b3b;
    on-secondary-container: #ffffff;
    tertiary: #0077A3;
    tertiary-fixed: #0077A3;
    tertiary-fixed-dim: #0077A3;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #ffffff;
    tertiary-container: #3b3b3b;
    on-tertiary-container: #ffffff;
    error: #C70000;
    on-error: #ffffff;
    error-container: #3b3b3b;
    on-error-container: #ffffff;
    surface: #3b3b3b;
    on-surface: #ffffff;
    on-surface-variant: #cccccc;
    outline: #aaaaaa;
    outline-variant: #888888;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ffffff;
    inverse-on-surface: #3b3b3b;
    inverse-primary: #ffffff;
    surface-dim: #2f2f2f;
    surface-bright: #595959;
    surface-container-lowest: #383838;
    surface-container-low: #3b3b3b;
    surface-container: #595959;
    surface-container-high: #6e6e6e;
    surface-container-highest: #7d7d7d;
}
