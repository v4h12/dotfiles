    secondary-fixed-dim: #d97706;
    on-secondary: #ffffff;
    on-secondary-fixed: #ffffff;
    on-secondary-fixed-variant: #ffffff;
    secondary-container: #fef3c7;
    on-secondary-container: #92400e;
    tertiary: #9333ea;
    tertiary-fixed: #9333ea;
    tertiary-fixed-dim: #9333ea;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #ffffff;
    tertiary-container: #f3e8ff;
