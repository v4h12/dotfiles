    secondary-fixed: #ffdd88;
    secondary-fixed-dim: #ffdd88;
    on-secondary: #000000;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #000000;
    secondary-container: #8b6f47;
    on-secondary-container: #ffdd88;
    tertiary: #ff8888;
