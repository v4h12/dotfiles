* {
    primary: rgba(255, 255, 255, 0.3);
    primary-fixed: #000000;
    primary-fixed-dim: #000000;
    on-primary: #ffffff;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #ffffff;
    primary-container: rgba(0, 0, 0, 0);
    on-primary-container: #1e40af;
    secondary: #ffdd88;
    secondary-fixed: #ffdd88;
    secondary-fixed-dim: #ffdd88;
    on-secondary: #000000;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #000000;
    secondary-container: #fef3c7;
    on-secondary-container: #92400e;
    tertiary: #88ddff;
    tertiary-fixed: #88ddff;
    tertiary-fixed-dim: #88ddff;
    on-tertiary: #000000;
    on-tertiary-fixed: #000000;
    on-tertiary-fixed-variant: #000000;
    tertiary-container: #e5e5e5;
    on-tertiary-container: #000000;
    error: #ff8888;
    on-error: #000000;
    error-container: #e5e5e5;
    on-error-container: #000000;
    surface: rgba(255, 255, 255, 0.5);
    on-surface: #000000;
    on-surface-variant: #4b5563;
    outline: #6b7280;
    outline-variant: #9ca3af;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #1f2937;
    inverse-on-surface: #e0f2fe;
    inverse-primary: #60a5fa;
    surface-dim: #e0f2fe;
    surface-bright: #ffffff;
    surface-container-lowest: #d0e9fa;
    surface-container-low: #e0f2fe;
    surface-container: rgba(255, 255, 255, 0.5);
    surface-container-high: #f0f8ff;
    surface-container-highest: #ffffff;
}
