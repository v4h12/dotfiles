    on-error: #000000;
    error-container: #524f4f;
    on-error-container: #ff9966;
    surface: #1f1e20;
    on-surface: #ba531a;
    // on-surface: #d4a574;
    on-surface-variant: #524f4f;
    outline: #524f4f;
    outline-variant: #25180c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ba531a;
    inverse-on-surface: #1f1e20;
    inverse-primary: #1f1e20;
    surface-dim: #1f1e20;
    surface-bright: #1f1e20;
    surface-container-lowest: #1f1e20;
