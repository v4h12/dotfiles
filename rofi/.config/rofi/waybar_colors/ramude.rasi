* {
    primary: #524f4f;
    primary-fixed: #ba531a;
    primary-fixed-dim: #ba531a;
    on-primary: #ba531a;
    on-primary-fixed: #000000;
    on-primary-fixed-variant: #000000;
    primary-container: #524f4f;
    on-primary-container: #ba531a;
    secondary: #ffcc77;
    secondary-fixed: #ffcc77;
    secondary-fixed-dim: #ffcc77;
    on-secondary: #000000;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #000000;
    secondary-container: #524f4f;
    on-secondary-container: #ffcc77;
    tertiary: #88ccff;
    tertiary-fixed: #88ccff;
    tertiary-fixed-dim: #88ccff;
    on-tertiary: #000000;
    on-tertiary-fixed: #000000;
    on-tertiary-fixed-variant: #000000;
    tertiary-container: #524f4f;
    on-tertiary-container: #88ccff;
