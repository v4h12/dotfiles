* {
    primary: #ffffff;
    primary-fixed: #ffffff;
    primary-fixed-dim: #ffffff;
    on-primary: #000000;
    on-primary-fixed: #000000;
    on-primary-fixed-variant: #000000;
    primary-container: #333333;
    on-primary-container: #ffffff;
    secondary: #E5A700;
    secondary-fixed: #E5A700;
    secondary-fixed-dim: #E5A700;
    on-secondary: #000000;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #000000;
    secondary-container: #333333;
    on-secondary-container: #ffffff;
    tertiary: #0077A3;
    tertiary-fixed: #0077A3;
    tertiary-fixed-dim: #0077A3;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #ffffff;
    tertiary-container: #333333;
    on-tertiary-container: #ffffff;
    error: #C70000;
    on-error: #ffffff;
    error-container: #333333;
    on-error-container: #ffffff;
    surface: #1a1a1a;
    on-surface: #e5e5e5;
    on-surface-variant: #4a4a4a;
    outline: #6a6a6a;
    outline-variant: #909090;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e5e5e5;
    inverse-on-surface: #1a1a1a;
    inverse-primary: #1a1a1a;
    surface-dim: #1a1a1a;
    surface-bright: #333333;
    surface-container-lowest: #121212;
    surface-container-low: #1a1a1a;
    surface-container: #212121;
    surface-container-high: #2c2c2c;
    surface-container-highest: #333333;
}
