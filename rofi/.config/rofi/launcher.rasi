configuration {
    show-icons: true;
    icon-theme: "hicolor";
    display-drun: "";
    font: "JetBrainsMono Nerd Font 10";
}
@import "colors.rasi"
/*
* {
    bg:     #1a1a1a;
    fg:     #cdd6f4;
    accent: #3d5566;
    sep:    #2a2a3e;
}
*/
* {
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    border-radius: 0px;
    location: north;
    anchor: north;
    width: 100%;
    border: 0px 0px 1px 0px;
    border-color: @sep;
}
mainbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 0px;
    padding: 0px;
    border: 0px;
}
inputbar {
    background-color: @bg;
    padding: 3px 3px;
    spacing: 1px;
    children: [ entry ];
    border: 0px 0px 1px 0px;
    border-color: @sep;
}
entry {
    text-color: @fg;
    placeholder: " ";
    placeholder-color: @accent;
    font: "JetBrainsMono Nerd Font 10";
}
listview {
    lines: 7;
    scrollbar: false;
    spacing: 0px;
    padding: 0px;
    border: 0px;
}
element {
    orientation: horizontal;
    background-color: transparent;
    border-radius: 0px;
    padding: 3px 6px;
    spacing: 6px;
    border: 0px 0px 1px 0px;
    border-color: @sep;
}
element selected.normal {
    background-color: @accent;
    text-color: @bg;
    border-color: @accent;
}
element-icon {
    size: 16px;
    cursor: inherit;
}
element-text {
    font: "JetBrainsMono Nerd Font 10";
    // vertical-align: 0.5;
    vertical-align: 0.1;
    cursor: inherit;
    background-color: inherit;
    text-color: inherit;
}
